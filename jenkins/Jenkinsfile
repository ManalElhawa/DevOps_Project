pipeline {
    agent any
    environment {
        AWS_DEFAULT_REGION = 'us-east-1' // change to your target AWS region
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Build & Test') {
            steps {
                sh '''
                echo "--- Checking repository files ---"
                ls -la

                echo "--- Running PHP syntax checks (if any .php files exist) ---"
                if find . -maxdepth 4 -name "*.php" | grep -q .; then
                    find . -maxdepth 4 -name "*.php" -exec php -l {} +
                else
                    echo "No local .php files found in repository; skipping php -l."
                fi
                 '''
            }
        }
        stage('Security & Static Analysis') {
            steps {
                sh '''
                    for file in cloudformation/templates/ATU-3Tier-Website.yaml cloudformation/templates/ATU-Static-Website.yaml; do
                        if [ -f "$file" ]; then
                            echo "--- Scanning security for: $file ---"
                            trivy config "$file"
                        fi
                    done
                '''
            }
        }
        stage('Linting & Validation') {
            steps {
                withCredentials([
                    string(credentialsId: 'aws-access-key-id', variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'aws-secret-access-key', variable: 'AWS_SECRET_ACCESS_KEY')
                ]) {
                    sh '''
                        for file in cloudformation/templates/ATU-3Tier-Website.yaml cloudformation/templates/ATU-Static-Website.yaml; do
                            if [ -f "$file" ]; then
                                echo "--- Validating syntax for: $file ---"
                                # cfn-lint -b -i W1011 "$file" || true
                                aws cloudformation validate-template --template-body "file://$file"
                            fi
                        done
                    '''
                }
            }
        }
        stage('Deploy') {
        steps {
        withCredentials([
            string(credentialsId: 'aws-access-key-id', variable: 'AWS_ACCESS_KEY_ID'),
            string(credentialsId: 'aws-secret-access-key', variable: 'AWS_SECRET_ACCESS_KEY'),
            string(credentialsId: 'db-master-username', variable: 'DB_USER'),
            string(credentialsId: 'db-master-password', variable: 'DB_PASS')
        ]) {
            sh '''
                if [ -f cloudformation/templates/ATU-Static-Website.yaml ]; then
                    echo "--- Deploying Static Website stack ---"
                    aws cloudformation deploy \
                        --template-file cloudformation/templates/ATU-Static-Website.yaml \
                        --stack-name atu-static-website \
                        --capabilities CAPABILITY_IAM CAPABILITY_NAMED_IAM
                fi

                if [ -f cloudformation/templates/ATU-3Tier-Website.yaml ]; then
                    echo "--- Deploying 3-Tier Website stack ---"
                    aws cloudformation deploy \
                        --template-file cloudformation/templates/ATU-3Tier-Website.yaml \
                        --stack-name atu-3tier-website \
                        --capabilities CAPABILITY_IAM CAPABILITY_NAMED_IAM \
                        --parameter-overrides \
                            MasterUsername="$DB_USER" \
                            MasterUserPassword="$DB_PASS"
                    
                    echo "--- Running post-deploy smoke test ---"
                    WEBSITE_URL=$(aws cloudformation describe-stacks \
                    --stack-name atu-3tier-website \
                    --query "Stacks[0].Outputs[?OutputKey=='WebsiteURL'].OutputValue" \
                    --output text 2>/dev/null || true)

                    if [ -n "$WEBSITE_URL" ] && [ "$WEBSITE_URL" != "None" ]; then
                      echo "Testing $WEBSITE_URL"
                      curl -fsS --max-time 15 "$WEBSITE_URL" > /dev/null
                      echo "WebsiteURL responded with HTTP 200."
                    else
                      echo "WebsiteURL output not found yet."
                    fi
                fi
            '''
        }
    }
}
    }
    post {
        success {
            echo 'All CloudFormation templates passed security and validation checks!'
        }
        failure {
            echo 'Pipeline failed. Check scanner output above for errors in your templates.'
        }
    }
}