pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Security & Static Analysis') {
            steps {
                sh '''
                    for file in cloudformation/templates/ATU-3Tier-Website.yaml cloudformation/templates/ATU-Static-Website.yaml; do
                        if [ -f "$file" ]; then
                            echo "--- Scanning security for: $file ---"
                            snyk iac test "$file"
                            trivy config "$file"
                        fi
                    done
                '''
            }
        }
        stage('Linting & Validation') {
            steps {
                sh '''
                    for file in cloudformation/templates/ATU-3Tier-Website.yaml cloudformation/templates/ATU-Static-Website.yaml; do
                        if [ -f "$file" ]; then
                            echo "--- Validating syntax for: $file ---"
                            cfn-lint "$file"
                            aws cloudformation validate-template --template-body file://$file
                        fi
                    done
                '''
            }
        }
    }
    post {
        success {
            echo 'All CloudFormation templates passed security and validation checks!'
        }
        failure {
            echo 'Pipeline failed. Check scanner output above for errors in your templates.'
        }
    }
}